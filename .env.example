# ---- Site ----
# Endereço da Kirana VISTO PELO SERVIDOR do site (não é exposto ao navegador).
KIRANA_URL=http://127.0.0.1:3000
# Token da Kirana (KIRANA_ACCESS_TOKEN dela). Só no servidor. Nunca em NEXT_PUBLIC_*.
KIRANA_TOKEN=
# Site registrado no kit da Kirana (sites/<id>/site.json)
KIRANA_SITE_ID=opportunity-ai
# Tempo máximo de espera por resposta (ms)
KIRANA_TIMEOUT_MS=120000

# URL pública do site (metadados/OpenGraph)
SITE_URL=https://opportunity.ia.br

# Para onde enviar os leads do formulário de contato.
# Sem esta variável, o lead é gravado em data/leads.jsonl e o visitante é
# avisado de que o envio automático ainda não está configurado.
CONTACT_WEBHOOK_URL=

# Banco é OPCIONAL neste site (só o /api/health usa).
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# ---- Kirana online no site ESTÁTICO (GitHub Pages) ----
# Endereço PÚBLICO da Kirana (não é segredo; nunca coloque chave aqui). Vazio = atendimento guiado.
# No GitHub: Settings > Secrets and variables > Actions > Variables > KIRANA_URL.
# Passo a passo: docs/KIRANA-ONLINE-PESSOAL.md
NEXT_PUBLIC_KIRANA_URL=
# Id do site na Kirana (sites/<id>).
NEXT_PUBLIC_KIRANA_SITE_ID=opportunity-ai
# Janela em que o PC da Kirana descansa (fuso de Fortaleza). Vazio desliga.
NEXT_PUBLIC_KIRANA_DESCANSO=00:00-06:00
